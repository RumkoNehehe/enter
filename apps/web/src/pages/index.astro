---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const articles = [
  {
    title: "Prvý testovací článok",
    slug: "prvy-testovaci-clanok",
    excerpt: "Toto je iba lokálny článok, neskôr pôjde zo Sanity.",
    category: "Kultúra"
  },
  {
    title: "Druhý článok",
    slug: "druhy-clanok",
    excerpt: "Overujeme si Astro routing a komponenty.",
    category: "Technológie"
  }
];
---

<BaseLayout title="Magazín POC">
  <main>
    <h1>Magazín POC</h1>
    <p>Technický prototyp Astro + Sanity magazínu.</p>

    <section>
      {articles.map((article) => (
        <ArticleCard
          title={article.title}
          slug={article.slug}
          excerpt={article.excerpt}
          category={article.category}
        />
      ))}
    </section>
  </main>
</BaseLayout>