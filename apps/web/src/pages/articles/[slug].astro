---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PortableText } from "astro-portabletext";
import { getArticleBySlug, getArticleSlugs } from "../../lib/queries/articles";
import { urlFor } from "../../lib/image";

export async function getStaticPaths() {
    const articles = await getArticleSlugs();

    return articles.map((article) => ({
        params: {
            slug: article.slug,
        },
    }));
}

const { slug } = Astro.params;
const article = slug ? await getArticleBySlug(slug) : null;

if (!article) {
    return Astro.redirect("/404");
}

const imageUrl = article.mainImage
    ? urlFor(article.mainImage).width(1200).height(675).url()
    : null;
---

<BaseLayout title={article.title}>
    <a href="/">← Späť na homepage</a>

    <article>
        {
            article.category && (
                <p>
                    <a href={`/categories/${article.category.slug}/`}>
                        {article.category.title}
                    </a>
                </p>
            )
        }

        <h1>{article.title}</h1>

        {article.excerpt && <p>{article.excerpt}</p>}

        {
            imageUrl && (
                <img
                    src={imageUrl}
                    alt={article.mainImage?.alt ?? article.title}
                    width="1200"
                    height="675"
                />
            )
        }

        {
            article.author?.slug && (
                <p>
                    Autor:{" "}
                    <a href={`/authors/${article.author.slug}/`}>
                        {article.author.name}
                    </a>
                </p>
            )
        }

        {
            article.publishedAt && (
                <time datetime={article.publishedAt}>
                    {new Date(article.publishedAt).toLocaleDateString("sk-SK")}
                </time>
            )
        }

        {article.body && <PortableText value={article.body} />}
    </article>
</BaseLayout>
