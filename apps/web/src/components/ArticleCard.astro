---
type Props = {
  title: string;
  slug: string;
  excerpt?: string;
  publishedAt?: string;
};

const { title, slug, excerpt, publishedAt } = Astro.props;
---

<article>
  <h2>
    <a href={`/articles/${slug}/`}>{title}</a>
  </h2>

  {excerpt && <p>{excerpt}</p>}

  {publishedAt && (
    <time datetime={publishedAt}>
      {new Date(publishedAt).toLocaleDateString("sk-SK")}
    </time>
  )}
</article>