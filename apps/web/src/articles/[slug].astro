---
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = [
  {
    title: "Prvý testovací článok",
    slug: "prvy-testovaci-clanok",
    body: "Toto je detail prvého článku."
  },
  {
    title: "Druhý článok",
    slug: "druhy-clanok",
    body: "Toto je detail druhého článku."
  }
];

export function getStaticPaths() {
  return articles.map((article) => ({
    params: {
      slug: article.slug
    },
    props: {
      article
    }
  }));
}

const { article } = Astro.props;
---

<BaseLayout title={article.title}>
  <main>
    <a href="/">← Späť na homepage</a>

    <article>
      <h1>{article.title}</h1>
      <p>{article.body}</p>
    </article>
  </main>
</BaseLayout>